# Cloudflare Pages headers: always check for the newest build, and allow any site to load it.
/*
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *

# The portal is only for signed-in people: no framing by other sites, no shared caching.
/app/*
  ! Access-Control-Allow-Origin
  X-Frame-Options: DENY
  X-Robots-Tag: noindex
  Referrer-Policy: same-origin
  X-Content-Type-Options: nosniff

# Admin sign-in: never framed, cached, indexed or sent as a referrer; only this site's own scripts run.
/admin/*
  ! Access-Control-Allow-Origin
  ! Cache-Control
  Cache-Control: no-store
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'none'; object-src 'none'

# Pictures for update emails: cache them, since they never change.
/email/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000

# The 3D phone model on the homepage: cache it, it rarely changes.
/demo/iphone-17-pro.glb
  ! Cache-Control
  Cache-Control: public, max-age=604800
