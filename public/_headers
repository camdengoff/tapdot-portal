# Cloudflare Pages headers: always check for the newest build, and allow any site to load it.
/*
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *

# The portal is only for signed-in people: no framing by other sites, no shared caching.
/app/*
  ! Access-Control-Allow-Origin
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  X-Content-Type-Options: nosniff

# Pictures for update emails: cache them, since they never change.
/email/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000

# The 3D phone model on the homepage: cache it, it rarely changes.
/demo/iphone-17-pro.glb
  ! Cache-Control
  Cache-Control: public, max-age=604800
